{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/matchbuddy-.log",
      "RetainedFileCountLimit": 14
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MatchBuddy": "Server=(localdb)\\mssqllocaldb;Database=MatchBuddy;Trusted_Connection=true"
  },
  "Jwt": {
    "Issuer": "MatchBuddy.Api",
    "Audience": "MatchBuddy.Client",
    "ExpiresMinutes": 120,
    "Key": ""
  },
  "Reminders": {
    "IntervalSeconds": 600
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "Root": ""
    },
    "S3": {
      "ServiceUrl": "",
      "Bucket": "",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": "",
      "Region": "auto"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Localization": {
    "DefaultCulture": "tr",
    "SupportedCultures": [
      "tr",
      "en"
    ]
  },
  "Proxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Swagger": {
    "Enabled": false
  }
}
