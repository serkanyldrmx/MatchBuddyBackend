{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MatchBuddy": "Server=(localdb)\\mssqllocaldb;Database=MatchBuddy;Trusted_Connection=true"
  },
  "Jwt": {
    "Issuer": "MatchBuddy.Api",
    "Audience": "MatchBuddy.Client",
    "ExpiresMinutes": 120,
    "Key": ""
  },
  "Reminders": {
    "IntervalSeconds": 600
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "UploadPermitLimit": 20
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "Root": ""
    },
    "S3": {
      "ServiceUrl": "",
      "Bucket": "",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": "",
      "Region": "auto"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
