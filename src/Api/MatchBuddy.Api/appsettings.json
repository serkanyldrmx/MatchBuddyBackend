{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MatchBuddy": "Server=(localdb)\\mssqllocaldb;Database=MatchBuddy;Trusted_Connection=true"
  },
  "Jwt": {
    "Issuer": "MatchBuddy.Api",
    "Audience": "MatchBuddy.Client",
    "ExpiresMinutes": 120,
    "Key": ""
  },
  "Reminders": {
    "IntervalSeconds": 600
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
