<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e1b2411e-c568-4d3d-94ed-e02cea80906d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!-- Yapılandırılmış loglama (docs/platform-api.md): konsol + günlük dönen dosya -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Medya hattı (docs/media-api.md): SkiaSharp (MIT) + Linux native, S3/R2 depolama -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MatchBuddy.Core\MatchBuddy.Core.csproj" />
    <ProjectReference Include="..\..\MatchBuddy.Business\MatchBuddy.Business.csproj" />
    <ProjectReference Include="..\..\MatchBuddy.DataAccess\MatchBuddy.DataAccess.csproj" />
    <ProjectReference Include="..\..\MatchBuddy.Entities\MatchBuddy.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MatchBuddy.Core.Errors" />
    <Using Include="MatchBuddy.Core.Localization" />
    <Using Include="MatchBuddy.Core.Parameters" />
    <Using Include="MatchBuddy.Api.Infrastructure" />
  </ItemGroup>

</Project>
