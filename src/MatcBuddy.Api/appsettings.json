{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/matcbuddy-.log",
      "RetainedFileCountLimit": 14
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MatcBuddy": "Server=(localdb)\\mssqllocaldb;Database=MatcBuddy;Trusted_Connection=true"
  },
  "Jwt": {
    "Issuer": "MatcBuddy.Api",
    "Audience": "MatcBuddy.Client",
    "Key": ""
  },
  "Auth": {
    "FrontendBaseUrl": "http://localhost:3000",
    "RefreshCookie": {
      "Name": "mb_rt",
      "Path": "/api/Auth",
      "SameSite": "Lax",
      "Domain": ""
    },
    "Google": {
      "ClientId": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "",
      "FromName": "MatcBuddy",
      "UseSsl": true
    }
  },
  "Sms": {
    "Netgsm": {
      "UserCode": "",
      "Password": "",
      "Header": ""
    }
  },
  "Messaging": {
    "OutboxPath": "App_Data/outbox"
  },
  "Reminders": {
    "IntervalSeconds": 600
  },
  "WebPush": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "",
    "IntervalSeconds": 5
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "Root": ""
    },
    "S3": {
      "ServiceUrl": "",
      "Bucket": "",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": "",
      "Region": "auto"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Localization": {
    "DefaultCulture": "tr",
    "SupportedCultures": [
      "tr",
      "en"
    ]
  },
  "Proxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Swagger": {
    "Enabled": false
  }
}
