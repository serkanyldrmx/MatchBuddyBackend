<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MatchBuddy.Core\MatchBuddy.Core.csproj" />
    <ProjectReference Include="..\MatchBuddy.Entities\MatchBuddy.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MatchBuddy.Core.Errors" />
    <Using Include="MatchBuddy.Core.Localization" />
    <Using Include="MatchBuddy.Core.Parameters" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient'ın getirdiği 9.0.x sürümündeki bilinen açıklar (GHSA-2fmv / GHSA-846f) için sabitleme -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
